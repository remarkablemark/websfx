{
  "name": "websfx",
  "version": "1.0.0",
  "description": "Play synthesized UI sound effects using the Web Audio API",
  "author": "Mark <mark@remarkablemark.org> (https://remarkablemark.org)",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf coverage dist docs",
    "docs": "vite build",
    "docs:watch": "vite",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "lint:package": "publint",
    "lint:tsc": "tsc",
    "lint:types": "npx @arethetypeswrong/cli --pack",
    "prepare": "husky",
    "prepublishOnly": "npm run build && npm run lint && npm run lint:tsc && npm run test:ci",
    "test": "vitest run",
    "test:ci": "CI=true npm test -- --color --coverage",
    "test:watch": "vitest --coverage.enabled=false"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remarkablemark/websfx.git"
  },
  "bugs": {
    "url": "https://github.com/remarkablemark/websfx/issues"
  },
  "keywords": [
    "audio",
    "browser",
    "sfx",
    "sound-effects",
    "web-audio-api"
  ],
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@microsoft/api-extractor": "7.59.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-tsdoc": "0.5.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "publint": "0.3.25",
    "tailwindcss": "4.3.3",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "files": [
    "dist/",
    "src/"
  ],
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/remarkablemark"
    }
  ],
  "license": "MIT"
}
